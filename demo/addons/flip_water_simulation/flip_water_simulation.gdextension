[configuration]

entry_symbol = "flip_sim_library_init"
compatibility_minimum = "4.2"
reloadable = true

[libraries]

macos.debug = "res://addons/flip_water_simulation/bin/libflipsim.macos.template_debug.framework"
macos.release = "res://addons/flip_water_simulation/bin/libflipsim.macos.template_release.framework"
windows.debug.x86_64 = "res://addons/flip_water_simulation/bin/libflipsim.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/flip_water_simulation/bin/libflipsim.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/flip_water_simulation/bin/libflipsim.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/flip_water_simulation/bin/libflipsim.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://addons/flip_water_simulation/bin/libflipsim.linux.template_debug.arm64.so"
linux.release.arm64 = "res://addons/flip_water_simulation/bin/libflipsim.linux.template_release.arm64.so"

[icons]

FLIPWaterSimulation = "res://addons/flip_water_simulation/icon.svg"
FLIPEmitter = "res://addons/flip_water_simulation/icon.svg"
FLIPDrain = "res://addons/flip_water_simulation/icon.svg"
FLIPForce = "res://addons/flip_water_simulation/icon.svg"
FLIPSensor = "res://addons/flip_water_simulation/icon.svg"
